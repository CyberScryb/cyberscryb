{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Firebase Static Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "public", "-l", "5000"],
      "port": 5000
    },
    {
      "name": "Firebase Emulators (requires firebase-tools)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["firebase", "emulators:start"],
      "port": 5000
    }
  ]
}
